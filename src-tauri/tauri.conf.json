{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Folio",
  "version": "0.1.0",
  "identifier": "com.folio.reader",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Folio",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 500,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "backgroundColor": "#f8f9fa"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "resources/ecdict.db": "resources/ecdict.db",
      "resources/models/ch_PP-OCRv4_det_infer.onnx": "resources/models/ch_PP-OCRv4_det_infer.onnx",
      "resources/models/ch_PP-OCRv4_rec_infer.onnx": "resources/models/ch_PP-OCRv4_rec_infer.onnx",
      "resources/models/ppocr_keys_v1.txt": "resources/models/ppocr_keys_v1.txt",
      "resources/lib/onnxruntime.dll": "resources/lib/onnxruntime.dll"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
